<?xml version="1.0" encoding="utf-8"?>
<!--
    Veil's mark for the status bar: a disc behind horizontal slits — something
    seen through a screen.

    Replaces the one :core carries, because the service that shows the
    notification is shared and would otherwise put Shard's mark in Veil's shade.

    Drawn as the three pieces the slits leave rather than as a disc with bars
    punched out of it. A bar wide enough to reach the edge overhangs it; one
    narrow enough not to stops short of it and leaves a crescent. Each piece
    follows the disc's own arc, so the slits meet the edge exactly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.137,7.38 A9.12,9.12 0 0 1 19.863,7.38 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3.253,9.42 L20.747,9.42 A9.12,9.12 0 0 1 20.747,14.58 L3.253,14.58 A9.12,9.12 0 0 1 3.253,9.42 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.137,16.62 A9.12,9.12 0 0 0 19.863,16.62 Z" />
</vector>
