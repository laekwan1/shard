<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions come from :core, which both apps share. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veil"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Tor in a process of its own.

            The daemon is C, and it is written to be started once and then to
            end with the program that started it. Started a second time in the
            same process it aborts, and an abort takes the whole app with it —
            which is what switching the tunnel off and on again was doing.
            Given its own process it can abort as much as it likes: the browser
            stays up, and the next start gets a clean one.
        -->
        <service
            android:name="org.torproject.jni.TorService"
            android:process=":tor"
            tools:node="merge" />
    </application>
</manifest>
