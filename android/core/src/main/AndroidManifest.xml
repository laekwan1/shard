<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared by both apps through manifest merging. Neither declares a VPN
    service: the browser lives inside the app, so there is nothing to capture
    from other apps and no permission prompt to show.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed to write downloads on Android 9 and older; from 10 onwards
         MediaStore hands out its own destination. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Downloads carry on when the browser is not on screen. Android allows
         that only for a foreground service, and the notification it obliges us
         to show is where the engine switch and the progress live. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="net.sw.browser.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
