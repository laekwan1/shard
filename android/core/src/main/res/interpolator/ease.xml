<?xml version="1.0" encoding="utf-8"?>
<!--
    The house curve, the same numbers as the shell's house curve. It leaves quickly
    and settles slowly, so a movement reads as ending rather than stopping.
-->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.2"
    android:controlY1="0"
    android:controlX2="0"
    android:controlY2="1" />
