<?xml version="1.0" encoding="utf-8"?>
<!-- The stand-in album art on the player when a song, not a video, is playing:
     a warm rounded tile in the app's own amber, so the note has something to sit
     on rather than floating on black. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:startColor="#B06A2C"
        android:endColor="#E0A030"
        android:angle="135" />
</shape>
