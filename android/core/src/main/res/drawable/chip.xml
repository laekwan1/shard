<?xml version="1.0" encoding="utf-8"?>
<!--
    A folder button. Two states, because a chip that cannot show it is selected
    is a label — and the whole point of the row is saying which one is in force.
    Selected fills with the accent; unselected is a quiet outline, so the chosen
    one stands out rather than every chip shouting at once.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_lg" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_lg" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</selector>
