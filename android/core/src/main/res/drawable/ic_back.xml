<?xml version="1.0" encoding="utf-8"?>
<!--
    Back: an outlined triangle with rounded corners, pointing the way out.

    The user's own choice of mark. Drawn as one closed stroke with the corners
    cut by quadratics — a stroked triangle with sharp vertices reads as a play
    button turned around, and the rounding is what separates "back" from
    "rewind". Grey-white through the same tint every other glyph wears.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8.07,10.73 L14.93,6.87 Q17.2,5.6 17.2,8.2 L17.2,15.8 Q17.2,18.4 14.93,17.13 L8.07,13.27 Q5.8,12 8.07,10.73 Z" />
</vector>
