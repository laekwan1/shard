<!--
    Back: a drawn stroke, not the platform's filled block arrow.

    Every glyph this app draws is a 1.4-2 stroke with round caps — the
    transport, the toggles, the folder marks. The old back arrow was the one
    Material filled shape among them and sat visibly heavier than everything it
    shared a row with. Same reach, same meaning, lighter voice.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M19.5,12 L5.5,12" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M11.5,5.8 L5.3,12 L11.5,18.2" />
</vector>
