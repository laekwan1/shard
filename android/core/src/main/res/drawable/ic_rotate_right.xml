<!-- iOS SF Symbol "rotate.right": a COMPLETE (closed) rounded square — the screen — with a curved
     arrow arcing OUTSIDE its top-left corner, pointing clockwise. The square must stay closed;
     the previous version cut the corner open, which was wrong (user hit). Square as a closed
     rounded-rect path (VectorDrawable has no <rect>), plus the arc and a solid arrowhead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M9.2,8 H15.3 a2.2,2.2 0 0 1 2.2,2.2 V16.3 a2.2,2.2 0 0 1 -2.2,2.2 H9.2 a2.2,2.2 0 0 1 -2.2,-2.2 V10.2 a2.2,2.2 0 0 1 2.2,-2.2 z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M4,10.5 A6,6 0 0 1 10.5,4" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8.4,2.2 l2.7,1.9 l-2.2,2.5 z" />
</vector>
