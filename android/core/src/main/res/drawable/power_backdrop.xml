<?xml version="1.0" encoding="utf-8"?>
<!--
    A lit ring rather than a filled disc — the desktop build's icon reads as a
    glow on dark, and a solid button would not. Layered: a wide faint halo, a
    narrower brighter one, then the ring itself, which is as close to a bloom as
    a vector gets.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#22E0A030" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#33E0A030" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
