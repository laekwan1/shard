<?xml version="1.0" encoding="utf-8"?>
<!--
    A circular arrow with 90 in it — the reference's 360, a quarter instead of a
    whole turn. A near-complete ring opening at the top-right where a clean
    arrowhead sits, and the digits small and centred, drawn as thin outlines so
    they read as figures rather than blobs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">
    <!-- The ring, clockwise, open at the top-right. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M17.2,5.6 A8,8 0 1 1 12,4" />
    <!-- The arrowhead at the open end. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.4,1.6 L14.2,4.2 L11,6.4 Z" />
    <!-- 9: a small loop with a stem. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M10.7,11 a1.6,1.6 0 1 0 -1.5,1 L10.6,14.6" />
    <!-- 0: an outlined oval. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M14,9.7 a1.7,2.4 0 1 0 0.01,0" />
</vector>
