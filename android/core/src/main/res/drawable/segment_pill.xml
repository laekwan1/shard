<?xml version="1.0" encoding="utf-8"?>
<!--
    One segment of the video/music control. Selected, it lifts to a rounded pill
    with a hair of the accent around it; unselected, it is nothing at all, so the
    lifted one reads as the one in force.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_md" />
            <solid android:color="#34343B" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_md" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
