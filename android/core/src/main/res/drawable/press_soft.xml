<?xml version="1.0" encoding="utf-8"?>
<!--
    The pressed state for an icon button: a soft rounded square, bounded to
    the button.

    The borderless ripple these buttons wore grows past the glyph into a
    circle the size of the whole touch target, which on a 48dp button reads
    as the row lighting up rather than the button being pressed. Bounded and
    rounded, the light stays on the thing that was touched.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/state_drag">
    <!-- The glow is inset from the touch target: the target is 48dp because a
         finger needs it, but light filling all 48 made the press look bigger
         than the glyph it answered. 7dp off each side leaves a 34dp square —
         the glyph plus a hand's width of light around it. -->
    <item
        android:id="@android:id/mask"
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/r_md" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>
