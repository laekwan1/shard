<!-- The mirror of ic_rotate_right — iOS SF Symbol "rotate.left". Complete (closed) rounded square
     with the curved arrow at the top-RIGHT corner, turning the other way; shown while in landscape
     so the button reads as "turn back". Flipped horizontally. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">
    <group android:scaleX="-1" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:pathData="M9.2,8 H15.3 a2.2,2.2 0 0 1 2.2,2.2 V16.3 a2.2,2.2 0 0 1 -2.2,2.2 H9.2 a2.2,2.2 0 0 1 -2.2,-2.2 V10.2 a2.2,2.2 0 0 1 2.2,-2.2 z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:pathData="M4,10.5 A6,6 0 0 1 10.5,4" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M8.4,2.2 l2.7,1.9 l-2.2,2.5 z" />
    </group>
</vector>
