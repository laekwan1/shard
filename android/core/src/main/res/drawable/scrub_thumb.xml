<?xml version="1.0" encoding="utf-8"?>
<!--
    The handle: 10dp, growing to 14dp under a finger.

    Two shapes in a selector rather than one that is scaled, because a SeekBar
    takes the thumb's own intrinsic size — there is nothing to animate a scale
    on. The jump is what every player does anyway: the handle is either being
    held or it is not.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
</selector>
