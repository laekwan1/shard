<?xml version="1.0" encoding="utf-8"?>
<!--
    The scrub handle: a fixed 12dp circle.

    A single plain shape, not a pressed/idle selector. A SeekBar reads the
    thumb's intrinsic size to draw it, but a StateListDrawable does not report
    one reliably, so on a tall bar (this one is 32-48dp for a wide touch target)
    the thumb was stretched to the bar's height — a circle became an oval. A
    plain shape carries its own size and stays round. The press-grow is dropped;
    a handle that is always round matters more than one that swells.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size android:width="12dp" android:height="12dp" />
    <solid android:color="@color/accent" />
</shape>
