<?xml version="1.0" encoding="utf-8"?>
<!--
    The disc the reload arrow is drawn on while the page is pulled down. Filled
    rather than a lit ring like the power button: this one comes down over the
    page, whatever colour the page happens to be, and a ring would leave the
    arrow standing on a white site with nothing behind it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/chrome" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</layer-list>
