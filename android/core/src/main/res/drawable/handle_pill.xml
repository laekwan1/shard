<?xml version="1.0" encoding="utf-8"?>
<!--
    The pill the current site's name sits in, top left of the page.

    This is the way into the address panel, and it used to be a 4px bar that
    only someone who had already found it could find. A browser whose address
    bar cannot be discovered is a browser with no address bar. The pill says
    where you are and is visibly a thing to press; the panel it opens is
    unchanged.

    Dark and translucent because it lies on the page, and a page can be any
    colour — the same lesson as the player scrim and the duration badge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="#CC17181C" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
