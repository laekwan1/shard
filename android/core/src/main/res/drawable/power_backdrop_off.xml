<?xml version="1.0" encoding="utf-8"?>
<!--
    The same ring with the light taken out of it.

    Dimming the lit one was not enough to read on a dark screen: a faint glow
    and a bright glow are the same thing seen at two distances, and the question
    is not how strongly the engine is running but whether it is.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#228A8A90" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#338A8A90" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/muted" />
        </shape>
    </item>
</layer-list>
