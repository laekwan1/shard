<?xml version="1.0" encoding="utf-8"?>
<!--
    The hover/press highlight for a library row. The theme's default
    (?attr/selectableItemBackground) drew a highlight that sat inset and off-centre
    against the row — narrower than the row and not level top-to-bottom. This fills the
    row's whole rectangle exactly: a full-bounds mask, no inset and no corners, so the
    lit area IS the row — same width, symmetric above and below.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/state_hover">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
