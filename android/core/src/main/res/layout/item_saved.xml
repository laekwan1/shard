<?xml version="1.0" encoding="utf-8"?>
<!--
    One saved item, on one line.

    A frame out of the film at the head of the row, in the shape the film is —
    sixteen by nine. It was a 52dp square with the picture shrunk inside it,
    which is the shape of nothing this library holds: a video put in a square is
    a video with its sides thrown away, and the eye cannot tell two of them
    apart from the letterboxed sliver that survives.

    Everything on one line, as the desktop window does it: the name takes what
    is left, the facts sit at the end, and the running time rides in the corner
    of the frame rather than taking a second line of its own. Two lines per row
    halves how much of the library is on screen and the second line was never
    the reason anyone was looking.

    `blocksDescendants` is what makes tapping the row work at all. A row holding
    anything focusable — the menu button here — has its own click swallowed by
    that child, so the list appeared dead while the menu on it worked perfectly:
    every way into a file except the obvious one.
-->
<!--
    A frame around the row so the separator can live INSIDE it: a ListView's
    own divider is drawn between rows, which put the line half a step below
    the thumbnail's bottom edge. Here it is a child pinned to the content's
    bottom — the frame is the tallest child, so the content's bottom IS the
    frame's bottom edge, and the two lines are level by construction.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_highlight"
    android:descendantFocusability="blocksDescendants"
    android:paddingHorizontal="12dp"
    android:paddingVertical="0.5dp">

    <!-- Starts at the frame's right edge — 80dp, no gap — so it reads as the
         frame's own bottom line carrying on across the row.

         The bottom margin is not decoration, it is arithmetic: the row's
         height comes from the 48dp menu button, not the 45dp frame, and the
         frame sits centred in that — (48 − 45) / 2 above the row's floor. A
         line on the floor itself ran 1.5dp below the picture it claims to
         continue. If either height changes, this number changes with it. -->
    <View
        android:id="@+id/rowLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="1.5dp"
        android:background="@color/state_hover" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <!-- 80 by 45 is sixteen by nine exactly. With the padding the row is 51dp:
         the frame is the reason the row exists, so it takes the room, and the
         padding gives back what the frame took — a list row's neighbours are
         the same target, so it needs no 48 of its own. -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:layout_marginEnd="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shot_tile"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@null" />

        <!-- Laid over a video frame; hidden for music. -->
        <ImageView
            android:id="@+id/playBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_badge"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!--
            The running time, bottom right of the frame, where every video app
            puts it. Only when something knows it — a file whose length is
            unread shows no badge rather than a zero.
        -->
        <TextView
            android:id="@+id/length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:background="@drawable/duration_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Never squeezed: the name gives way first, because a name is the one
         thing here that can be cut and still read. -->
    <TextView
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:maxLines="1"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/more"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="@dimen/target"
        android:layout_height="@dimen/target"
        android:layout_marginStart="2dp"
        android:background="@drawable/press_soft"
        android:src="@drawable/ic_more"
        android:scaleType="fitCenter"
        android:padding="14dp"
        android:contentDescription="@string/menu" />
    </LinearLayout>
</FrameLayout>
