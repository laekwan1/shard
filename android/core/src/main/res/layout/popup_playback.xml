<?xml version="1.0" encoding="utf-8"?>
<!--
    The end-of-file switches, as a small popup off the folder-row gear: in
    order, at random, and background sound. Each is the same icon the player bar
    drew, with a short word beside it so the row is not a guess. Lit with the
    accent when it is on.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_backdrop"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/pbOnward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp"
        android:paddingVertical="11dp">

        <ImageView
            android:id="@+id/pbOnwardIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_onward"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pbOnwardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_order"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pbShuffle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp"
        android:paddingVertical="11dp">

        <ImageView
            android:id="@+id/pbShuffleIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_shuffle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pbShuffleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_shuffle"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pbBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp"
        android:paddingVertical="11dp">

        <ImageView
            android:id="@+id/pbBackgroundIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_offscreen"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pbBackgroundText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playback_background"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
