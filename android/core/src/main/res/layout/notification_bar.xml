<?xml version="1.0" encoding="utf-8"?>
<!--
    The collapsed row: the engine switch, then — when a video is playing — its
    controls in a box of their own. No title here; the title is in the expanded
    view, which is what pulling the notification down is for. Only the handful of
    views RemoteViews supports, and no custom text colours: the system tints
    those to match the shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <ImageButton
        android:id="@+id/power"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/on" />

    <!-- The playback controls, framed, shown only while a video plays. -->
    <LinearLayout
        android:id="@+id/pbFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@drawable/pb_frame"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/pbToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_playing" />

        <ImageButton
            android:id="@+id/pbStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100" />
    </LinearLayout>

    <TextView
        android:id="@+id/percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:minWidth="34dp"
        android:textSize="12sp" />
</LinearLayout>
