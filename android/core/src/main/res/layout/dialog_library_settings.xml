<?xml version="1.0" encoding="utf-8"?>
<!--
    The library's playback settings.

    Background playback is its own thing — whether sound survives the screen
    going — so it is a switch. What happens when a video ends is one question
    with one answer, so it is a single choice, not three switches that could
    contradict each other.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <!-- A switch, with a line under the label saying what it does, so the
         setting explains itself rather than needing to be known. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_background"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/library_background_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settingBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_on_end"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:paddingBottom="4dp" />

    <RadioGroup
        android:id="@+id/settingEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/endStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingStart="6dp"
            android:text="@string/library_end_stop"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/endNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingStart="6dp"
            android:text="@string/library_end_next"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/endShuffle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingStart="6dp"
            android:text="@string/library_end_shuffle"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </RadioGroup>
</LinearLayout>
