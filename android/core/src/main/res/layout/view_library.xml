<?xml version="1.0" encoding="utf-8"?>
<!--
    The offline library: a screen of its own over the browser.

    It is not a page and it is not a panel. What is saved has nothing to do with
    what is loaded, and mixing the two would mean a back press could land in
    either — so this covers the browser entirely and back returns to it.

    The shape is the one every video app settles on, because it is the one that
    lets you pick the next thing while the current one plays: the player across
    the top, the list under it. Expanding hides the list and nothing else, so
    coming back is the same gesture in reverse.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            The header: the way back, and the two shelves.

            Above the picture, not below it. It says which screen this is and
            which shelf is open, and a heading that appears under the thing it
            heads is not a heading — the picture was reading as the top of the
            screen and the switch as something floating between the video and
            the list. Order down the screen is now: what this is, what is
            playing, what there is.

            A back arrow at the left, where every screen on this phone puts it.
            A cross at the right would read as "dismiss this thing", and the
            library is not a thing on top of a screen — it is the screen.
        -->
        <!--
            The header wears the chrome colour and the folders and the list
            below keep the darker surface — the same grammar the desktop
            window uses, where the switch sits on the toolbar and opens onto a
            darker sheet that holds the folders and the files. Without the two
            grounds the folder row floated: nothing said which layer it
            belonged to.
        -->
        <LinearLayout
            android:id="@+id/libraryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/chrome"
            android:paddingStart="2dp"
            android:paddingEnd="10dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/backFromLibrary"
                android:layout_width="@dimen/target"
                android:layout_height="@dimen/target"
                android:background="@drawable/press_soft"
                android:src="@drawable/ic_back"
                android:scaleType="fitCenter"
                android:padding="12dp"
                android:contentDescription="@string/library_back" />

            <!--
                A frame rather than a row, because the lifted pill is one view
                that slides underneath the two halves. Two pills blinking on and
                off say "the state changed"; one pill travelling says "your
                press moved this here". The thumb's size and position are laid
                out in code — they depend on the frame's measured width.
            -->
            <FrameLayout
                android:id="@+id/kinds"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/segment_track"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="44dp"
                android:padding="4dp">

                <!--
                    Both dimensions are set in code. Zero here, and deliberately:
                    a match_parent child inside a wrap_content FrameLayout is
                    measured against the whole space on offer before the frame
                    has a size, and it inflated the header to the full screen —
                    the track must take its height from the labels, never from
                    the thumb that slides under them.
                -->
                <View
                    android:id="@+id/shelfThumb"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/segment_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tabVideo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:id="@+id/tabVideoIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_video"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tabVideoText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/library_tab_video"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabMusic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:id="@+id/tabMusicIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_music"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tabMusicText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/library_tab_music"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!--
            The stage. Sixteen by nine while the list is showing; the whole
            screen once expanded, which is done by changing this height.
        -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#000000"
            android:visibility="gone">

            <!--
                A surface and a player of our own rather than a VideoView.
                A VideoView lets its player go the moment its surface does, and
                a surface goes as soon as the app leaves the screen — so sound
                could never carry on in the background while one was in charge
                of it. Holding the player here means the picture can go and the
                sound stay, which is what background playback is.
            -->
            <SurfaceView
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!--
                A song's cover, in the space a video's picture would fill.
                Whole rather than cropped to the shape of the stage: a cover is
                square and the stage is not, and a cover with its edges cut off
                is somebody's artwork with its edges cut off. Only up when the
                file actually carries one — an empty black block over a song
                that has no art says less than no block at all.
            -->
            <ImageView
                android:id="@+id/stageArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />

            <!--
                The way out of full screen, top left, where every screen keeps
                it. Only shown while full screen, because the header carries it
                the rest of the time.
            -->
            <!--
                On a disc of its own. The bar at the foot of the picture has a
                scrim under it; this one stands alone at the top, and a white
                arrow on a sunlit frame is not an arrow. The ripple moves to the
                foreground so the backdrop can have the background.
            -->
            <!--
                The title, on the picture at the top — where the desktop shows
                it and where a video app is expected to. Rides in and out with
                the rest of the controls, over a soft scrim so white text holds
                against a bright frame.
            -->
            <TextView
                android:id="@+id/stageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/player_scrim_top"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="18dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:text="" />

            <ImageButton
                android:id="@+id/leaveFullScreen"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/pull_backdrop"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:visibility="gone"
                android:contentDescription="@string/library_back" />

            <!--
                The player's own bar, in place of the framework's
                MediaController.

                That one drew white-and-lavender Material defaults over a screen
                that is black and cyan everywhere else, and there is no way to
                restyle it — it builds its own views. It also had room for
                nothing but play and seek, which left the things that belong on
                a player (what happens at the end, whether the sound carries on
                without the screen, the way out of full screen) scattered into a
                menu and a floating button.

                Drawn to the desktop player's shape: the scrubber on its own
                line, then one row of controls with the clock in it.
            -->
            <LinearLayout
                android:id="@+id/videoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="@drawable/player_scrim"
                android:paddingTop="26dp"
                android:paddingHorizontal="4dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <!--
                    The line sits right on top of the transport now, so the eye
                    goes from the play button straight to where it is. The times
                    ride its ends; the title moved up onto the picture, and the
                    end-of-file switches moved to the gear on the folder row.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/vbElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="42dp"
                        android:gravity="center"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:fontFeatureSettings="tnum"
                        android:text="0:00" />

                    <SeekBar
                        android:id="@+id/vbSeek"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/scrub_track"
                        android:thumb="@drawable/scrub_thumb"
                        android:background="@null"
                        android:splitTrack="false"
                        android:maxHeight="2dp"
                        android:max="1000" />

                    <TextView
                        android:id="@+id/vbTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="42dp"
                        android:gravity="center"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:fontFeatureSettings="tnum"
                        android:text="0:00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/vbPrev"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_pb_prev"
                        android:scaleType="fitCenter"
                        android:padding="14dp"
                        android:contentDescription="@string/library_previous" />

                    <ImageButton
                        android:id="@+id/vbToggle"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_pb_pause"
                        android:scaleType="fitCenter"
                        android:padding="11dp"
                        android:contentDescription="@string/library_playing" />

                    <ImageButton
                        android:id="@+id/vbNext"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_pb_next"
                        android:scaleType="fitCenter"
                        android:padding="14dp"
                        android:contentDescription="@string/library_next" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- The speed, stepping through the same set the desktop
                         offers. -->
                    <TextView
                        android:id="@+id/vbRate"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/target"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:text="1×" />

                    <!--
                        The sound: an icon, not a slider. Touch it and drag up or
                        down to set the level — the same as the side-drag, but
                        with a handle to reach for. A tap mutes.
                    -->
                    <ImageButton
                        android:id="@+id/vbMute"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_volume"
                        android:scaleType="fitCenter"
                        android:padding="13dp"
                        android:contentDescription="@string/library_mute" />

                    <ImageButton
                        android:id="@+id/expand"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_expand"
                        android:scaleType="fitCenter"
                        android:padding="14dp"
                        android:contentDescription="@string/library_expand" />
                </LinearLayout>
            </LinearLayout>

            <!--
                The brightness/volume gauge. Shown for a moment while the sides of
                the picture are dragged, so an adjustment has something to read
                against rather than being felt out in the dark.
            -->
            <LinearLayout
                android:id="@+id/gauge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/gauge_backdrop"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/gaugeIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_brightness"
                    android:contentDescription="@null" />

                <ProgressBar
                    android:id="@+id/gaugeBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="110dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progressDrawable="@drawable/gauge" />
            </LinearLayout>

        </FrameLayout>

        <!--
            The music player: a bar at the top where a video's picture would be,
            not the video stage. A song has no picture, so it does not take the
            screen — it carries its art, title, a scrubber to move through it, and
            play/pause and stop. Only up while a song is playing.
        -->
        <LinearLayout
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/chrome"
            android:elevation="6dp"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/npArt"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="@drawable/tile"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:src="@drawable/ic_music"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/npTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/npSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:text="@string/library_playing" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/npStop"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:scaleType="fitCenter"
                    android:padding="14dp"
                    android:contentDescription="@string/stop_download_description" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/npElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00" />

                <!-- Tinted by hand for the same reason as the video's; see there. -->
                <SeekBar
                    android:id="@+id/npSeek"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/target"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/scrub_track"
                    android:thumb="@drawable/scrub_thumb"
                    android:background="@null"
                    android:splitTrack="false"
                    android:maxHeight="2dp"
                    android:max="1000" />

                <TextView
                    android:id="@+id/npTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00" />
            </LinearLayout>

            <!--
                The same controls the video bar carries, in the same order. A
                song and a video are the same player with a different picture,
                and two orders for one set of buttons is two things to learn.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/npPrev"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pb_prev"
                    android:scaleType="fitCenter"
                    android:padding="14dp"
                    android:contentDescription="@string/library_previous" />

                <ImageButton
                    android:id="@+id/npToggle"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pb_pause"
                    android:scaleType="fitCenter"
                    android:padding="11dp"
                    android:contentDescription="@string/library_playing" />

                <ImageButton
                    android:id="@+id/npNext"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pb_next"
                    android:scaleType="fitCenter"
                    android:padding="14dp"
                    android:contentDescription="@string/library_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/npOnward"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_onward"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:contentDescription="@string/library_end_next" />

                <ImageButton
                    android:id="@+id/npShuffle"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_shuffle"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:contentDescription="@string/library_end_shuffle" />

                <ImageButton
                    android:id="@+id/npBackground"
                    android:layout_width="@dimen/target"
                    android:layout_height="@dimen/target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_offscreen"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:contentDescription="@string/library_background" />
            </LinearLayout>
        </LinearLayout>

        <!-- Everything below is hidden while the player is expanded. -->
        <LinearLayout
            android:id="@+id/libraryChrome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!--
                One row of folders, scrolled sideways, with the folder-making
                button pinned to its right end — on the same line as the tabs it
                belongs beside, not up in the title bar. A folder is a filter
                over the list below, not a place to navigate into.

                The menu that used to sit here is gone: everything it held was
                about what is playing, and it is all on the player bar now. It
                was removed once before while it was still the only way to reach
                those settings, which locked them away — hence the order.
            -->
            <!--
                A tab strip, in the browser's sense: the strip wears the chrome
                colour, the tab in force wears the list's, and the two merging
                is what says which folder the list below belongs to. The air
                above the tabs is what keeps them from hanging off the switch.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:background="@color/chrome"
                android:paddingTop="7dp">

                <HorizontalScrollView
                    android:id="@+id/folderScroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:paddingHorizontal="10dp">

                    <!--
                        baselineAligned off, and it matters: a horizontal
                        LinearLayout lines TextViews up by TEXT BASELINE by
                        default, and the + button's larger glyph dragged every
                        tab up off the strip's floor — tabs that are meant to
                        stand on the list were floating above it.
                    -->
                    <LinearLayout
                        android:id="@+id/folders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:baselineAligned="false" />
                </HorizontalScrollView>

                <!--
                    The end-of-file switches, gathered under a gear at the end of
                    the folder row: in order, at random, and whether the sound
                    carries on off screen. They were three buttons on the video
                    bar; here they are one, out of the way of the transport and
                    shared with the music player, which answers to the same
                    settings.
                -->
                <ImageButton
                    android:id="@+id/folderSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:scaleType="fitCenter"
                    android:padding="9dp"
                    android:contentDescription="@string/library_playback_settings" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/saved"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:scrollbarStyle="outsideOverlay" />

                <LinearLayout
                    android:id="@+id/libraryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="34dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/emptyIcon"
                        android:layout_width="@dimen/target"
                        android:layout_height="@dimen/target"
                        android:layout_marginBottom="14dp"
                        android:alpha="0.5"
                        android:src="@drawable/ic_video"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/library_empty"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
